# Variables de entorno del proyecto en Vercel (Settings → Environment Variables).
# Este archivo solo documenta los nombres: NO pongas valores reales aquí.

# Redis (Upstash). Las agrega solo la integración de Vercel Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# QStash (console.upstash.com → QStash)
QSTASH_TOKEN=
# URL regional de tu cuenta de QStash (la muestra la consola junto al token). Ej.: https://qstash-us-east-1.upstash.io
QSTASH_URL=
# Opcional: retraso máximo (horas) que admite el plan de QStash. Por defecto 24.
QSTASH_MAX_DELAY_HOURS=

# Secreto compartido con QStash:  openssl rand -hex 32
ALARM_SECRET=

# Secreto del cron diario de Vercel (api/cron/queue):  openssl rand -hex 32
# Vercel lo manda solo como "Authorization: Bearer …" al invocar el cron.
CRON_SECRET=

# URL pública de la app, sin "/" final. Ej.: https://tareas-eight-ashy.vercel.app
TAREAS_ORIGIN=

# Claves VAPID:  node tools/vapid-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
